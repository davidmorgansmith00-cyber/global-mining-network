{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gmn/content/schema/buildings.schema.json",
  "title": "Building Content Definitions",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "tier",
      "power_capacity",
      "cooling_capacity",
      "cost",
      "unlock_tier"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "tier": { "type": "integer", "minimum": 1 },
      "power_capacity": { "type": "number", "exclusiveMinimum": 0 },
      "cooling_capacity": { "type": "number", "minimum": 0 },
      "cost": { "type": "integer", "minimum": 0 },
      "unlock_tier": { "type": "integer", "minimum": 1 },
      "unlock_research_id": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  }
}
