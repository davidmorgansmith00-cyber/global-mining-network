{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gmn/content/schema/recipes.schema.json",
  "title": "Recipe Content Definitions",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "input_item_id",
      "output_item_id",
      "duration_seconds",
      "cost_credits",
      "unlock_tier"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "input_item_id": { "type": "string", "minLength": 1 },
      "output_item_id": { "type": "string", "minLength": 1 },
      "input_quantity": { "type": "integer", "minimum": 1 },
      "output_quantity": { "type": "integer", "minimum": 1 },
      "duration_seconds": { "type": "integer", "exclusiveMinimum": 0 },
      "cost_credits": { "type": "integer", "minimum": 0 },
      "unlock_tier": { "type": "integer", "minimum": 1 },
      "unlock_research_id": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  }
}
