{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmn/content/npc-market.schema.json",
  "title": "NPC Market Catalog Definition",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["item_id", "name", "description", "item_type", "price", "inventory"],
    "properties": {
      "item_id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 1 },
      "item_type": {
        "type": "string",
        "enum": ["hardware_upgrade", "facility_upgrade", "consumable", "cosmetic"]
      },
      "price": {
        "oneOf": [
          { "type": "integer", "exclusiveMinimum": 0 },
          { "type": "number", "exclusiveMinimum": 0 },
          { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
        ]
      },
      "inventory": {
        "oneOf": [
          { "type": "string", "const": "unlimited" },
          { "type": "integer", "minimum": 1 }
        ]
      },
      "restock_rate_per_day": { "type": "integer", "minimum": 1 },
      "unlock_condition": { "type": "string", "minLength": 1 }
    },
    "additionalProperties": false
  },
  "uniqueItems": false
}