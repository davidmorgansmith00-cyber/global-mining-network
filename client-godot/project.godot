; Global Mining Network Godot client
; Phase 1 UI foundation project configuration
config_version=5

[application]
config/name="Global Mining Network"
run/main_scene="res://scenes/gameplay_shell.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[network]
default_http_base_url="http://127.0.0.1:8000"
default_websocket_base_url="ws://127.0.0.1:8000"
